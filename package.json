{
  "name": "finnsikt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "dev": "node build.mjs --watch --run",
    "dev:persist": "node build.mjs --watch --run --persist",
    "dev:twilight": "node build.mjs --watch --run --browser=twilight",
    "dev:twilight:persist": "node build.mjs --watch --run --browser=twilight --persist",
    "package": "node build.mjs && web-ext build --source-dir dist --overwrite-dest --filename finnsikt.xpi",
    "addon:zen": "pnpm package && open -a /Applications/Zen.app web-ext-artifacts/finnsikt.xpi",
    "addon:twilight": "pnpm package && open -a /Applications/Twilight.app web-ext-artifacts/finnsikt.xpi",
    "lint": "tsc --noEmit && web-ext lint --source-dir dist",
    "test": "vitest run",
    "sign": "node build.mjs && web-ext sign --source-dir dist --channel unlisted"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
