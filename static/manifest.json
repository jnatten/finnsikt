{
  "manifest_version": 3,
  "name": "Finn Finder",
  "version": "0.1.0",
  "description": "Reisetider og månedskostnad i boligsøket på finn.no.",
  "browser_specific_settings": {
    "gecko": {
      "id": "finn-finder@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.finn.no/*", "https://api.entur.io/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.finn.no/realestate/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Finn Finder – innstillinger",
    "default_icon": "icon.svg"
  }
}
